# client/.env.production.example
# Copy to client/.env.production before running the production build
# (Vite automatically loads .env.production for `npm run build`).
# Not committed — deploy/deploy-frontend.sh checks for this file before building.

# Use a RELATIVE path. CloudFront serves the site over HTTPS and forwards
# /api/* to the EC2 server (see DEPLOYMENT.md, step 4), so the frontend and
# API share one domain. An absolute http://ec2-... address would be blocked by
# the browser as mixed content.
VITE_API_URL=/api

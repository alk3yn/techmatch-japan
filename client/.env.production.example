# client/.env.production.example
# Copy to client/.env.production before running the production build
# (Vite automatically loads .env.production for `npm run build`).
# Not committed — deploy/deploy-frontend.sh checks for this file before building.

# Point this at wherever the backend actually ends up:
#   - Using the nginx reverse proxy (recommended, see DEPLOYMENT.md): your EC2 public DNS, plain http/https, no port
#       VITE_API_URL=http://ec2-XX-XX-XX-XX.compute-1.amazonaws.com/api
#   - Talking to Node directly on port 5000 (simpler, but no HTTPS path later):
#       VITE_API_URL=http://ec2-XX-XX-XX-XX.compute-1.amazonaws.com:5000/api
VITE_API_URL=http://ec2-XX-XX-XX-XX.compute-1.amazonaws.com/api

#!/usr/bin/env bash
# deploy/deploy.config.sh.example
#
# Copy this to deploy/deploy.config.sh and fill in your real values.
# deploy.config.sh is gitignored — it holds your EC2 host, SSH key path,
# and AWS resource names, none of which belong in the repo.
#
#   cp deploy/deploy.config.sh.example deploy/deploy.config.sh
#   chmod +x deploy/deploy.config.sh deploy/deploy-backend.sh deploy/deploy-frontend.sh

# --- Backend (EC2) ---
EC2_HOST="ec2-XX-XX-XX-XX.compute-1.amazonaws.com"   # EC2 public DNS, from the EC2 console
EC2_USER="ec2-user"                                   # ec2-user for Amazon Linux, ubuntu for Ubuntu AMIs
EC2_KEY_PATH="$HOME/.ssh/techmatch-japan.pem"         # the .pem you downloaded when creating the key pair
REMOTE_APP_DIR="/home/$EC2_USER/techmatch-japan"      # where the repo lives on the instance

# --- Frontend (S3 + CloudFront) ---
S3_BUCKET="techmatch-japan-frontend"                  # your S3 bucket name (must be globally unique)
CLOUDFRONT_DISTRIBUTION_ID="E1AB2CD3EF4GH5"           # from the CloudFront console, after you create the distribution

# TechMatch Japan — server environment variables (local development)
# Copy this file to server/.env and fill in real values. Never commit the real .env file.
# (The repo-root .env.example holds the same settings with more comments.)

DATABASE_URL=postgresql://user:password@localhost:5432/techmatch
JWT_SECRET=replace-this-with-a-long-random-secret
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

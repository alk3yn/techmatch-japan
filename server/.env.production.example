# server/.env.production.example
# Copy to server/.env on the EC2 instance (not committed) and fill in real values.

# RDS endpoint — from the RDS console, "Connectivity & security" tab.
# sslmode=require is recommended for RDS; the pg Pool in config/db.js
# already sets ssl: { rejectUnauthorized: false } when NODE_ENV=production
# so RDS's self-signed chain doesn't need a CA bundle for this project's purposes.
DATABASE_URL=postgresql://techmatch_admin:REPLACE_ME@techmatch-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/techmatch

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the local-dev secret in production.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE

PORT=5000
NODE_ENV=production

# Comma-separated — include every origin the frontend is actually served
# from. Typically the CloudFront domain, and the S3 website endpoint while
# you're still testing before CloudFront is live. Drop the S3 one once
# CloudFront is confirmed working.
CLIENT_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net,http://techmatch-japan-frontend.s3-website-us-east-1.amazonaws.com

# server/.env.production.example
# Copy to server/.env on the EC2 instance (not committed) and fill in real values.

# RDS endpoint — from the RDS console, "Connectivity & security" tab.
# Use a password of letters and numbers only (symbols like @ : / # ? break the
# URL), and keep the whole value on one line with no spaces.
# The pg Pool in config/db.js already sets ssl: { rejectUnauthorized: false }
# when NODE_ENV=production, so this works on the server as written. When you run
# data/seed.js from your own machine (NODE_ENV is not production there), append
# ?sslmode=no-verify to this URL for that one command.
DATABASE_URL=postgresql://techmatch_admin:REPLACE_ME@techmatch-db.xxxxxxxxxx.ap-northeast-1.rds.amazonaws.com:5432/techmatch

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse the local-dev secret in production.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_VALUE

PORT=5000
NODE_ENV=production

# Comma-separated — include every origin the frontend is actually served
# from. This must match the CloudFront domain exactly (https://, no trailing
# slash). Add the S3 website endpoint only while testing before CloudFront is
# live, and drop it afterwards.
CLIENT_ORIGIN=https://dxxxxxxxxxxxxx.cloudfront.net
